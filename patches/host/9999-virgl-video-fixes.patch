+/*
+ * Local patch: EGL image for plane i of a VA surface's dmabuf. Passes the DRM
+ * format modifier when EGL takes one (upstream imports without it, which is
+ * only right for linear surfaces).
+ */
+static EGLImageKHR create_plane_egl_image(const struct virgl_video_dma_buf *dmabuf,
+                                          unsigned i)
+{
+    static int has_modifiers = -1;
+    const struct virgl_video_dma_buf_plane *p = &dmabuf->planes[i];
+    EGLint attrs[20];
+    unsigned k = 0;
+
+    if (has_modifiers < 0)
+        has_modifiers = epoxy_has_egl_extension(eglGetCurrentDisplay(),
+                                    "EGL_EXT_image_dma_buf_import_modifiers");
+
+    attrs[k++] = EGL_LINUX_DRM_FOURCC_EXT;      attrs[k++] = p->drm_format;
+    attrs[k++] = EGL_WIDTH;                     attrs[k++] = dmabuf->width / (i + 1);
+    attrs[k++] = EGL_HEIGHT;                    attrs[k++] = dmabuf->height / (i + 1);
+    attrs[k++] = EGL_DMA_BUF_PLANE0_FD_EXT;     attrs[k++] = p->fd;
+    attrs[k++] = EGL_DMA_BUF_PLANE0_OFFSET_EXT; attrs[k++] = p->offset;
+    attrs[k++] = EGL_DMA_BUF_PLANE0_PITCH_EXT;  attrs[k++] = p->pitch;
+    if (has_modifiers && p->modifier != DRM_FORMAT_MOD_INVALID) {
+        attrs[k++] = EGL_DMA_BUF_PLANE0_MODIFIER_LO_EXT;
+        attrs[k++] = (EGLint)(p->modifier & 0xffffffffu);
+        attrs[k++] = EGL_DMA_BUF_PLANE0_MODIFIER_HI_EXT;
+        attrs[k++] = (EGLint)(p->modifier >> 32);
+    }
+    attrs[k] = EGL_NONE;
+
+    return eglCreateImageKHR(eglGetCurrentDisplay(), EGL_NO_CONTEXT,
+                             EGL_LINUX_DMA_BUF_EXT, NULL, attrs);
+}
