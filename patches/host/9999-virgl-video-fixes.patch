+/*
+ * Local patch (9999-virgl-video-h264-packed-headers.patch), not upstream.
+ *
+ * Host Mesa >= 24.3 (VA frontend + radeonsi) takes several H.264 slice header
+ * fields only from packed headers sent by the VA client: the NAL header byte,
+ * frame_num, idr_pic_id, pic_order_cnt_lsb, the reference list modifications and
+ * the reference marking. It also writes SPS and PPS into the bitstream only when
+ * it got packed ones. The guest application's packed headers stop in the guest
+ * (the virgl protocol doesn't carry them), so without this every slice has NAL
+ * header 0x00 and frame_num 0, and the stream has no SPS/PPS of its own.
+ *
+ * So virglrenderer writes them from the picture description: SPS and PPS for
+ * each IDR picture, a slice header for every picture. Mesa parses them, writes
+ * its own SPS/PPS into the stream from what it parsed (as it does on bare metal
+ * with the application's headers) and builds the slice headers from them.
+ */
+struct h264_bs {
+    uint8_t buf[256];
+    unsigned bits;
+    bool overflow;
+};
+
+static void h264_bs_u(struct h264_bs *bs, unsigned n, uint32_t v)
+{
+    while (n--) {
+        if (bs->bits >= sizeof(bs->buf) * 8) {
+            bs->overflow = true;
+            return;
+        }
+        if ((v >> n) & 1)
+            bs->buf[bs->bits / 8] |= 0x80 >> (bs->bits % 8);
+        bs->bits++;
+    }
+}
+
+static void h264_bs_ue(struct h264_bs *bs, uint32_t v)
+{
+    uint32_t x;
+    unsigned len = 0;
+
+    if (v > 0xfffffffeu)
+        v = 0xfffffffeu;
+    x = v + 1;
+    while (len < 31 && (x >> (len + 1)))
+        len++;
+    h264_bs_u(bs, len, 0);
+    h264_bs_u(bs, len + 1, x);
+}
+
+static void h264_bs_se(struct h264_bs *bs, int32_t v)
+{
+    h264_bs_ue(bs, v > 0 ? 2 * (uint32_t)v - 1 : 2 * (uint32_t)(-(int64_t)v));
+}
+
+static void h264_bs_trailing_bits(struct h264_bs *bs)
+{
+    h264_bs_u(bs, 1, 1);
+    while (bs->bits % 8)
+        h264_bs_u(bs, 1, 0);
+}
+
+/* 4-byte start code, NAL header byte, RBSP with emulation prevention bytes */
+static unsigned h264_bs_to_nal(const struct h264_bs *bs, uint8_t nal_header,
+                               uint8_t *out, unsigned size)
+{
+    unsigned i, n = 0, zeros = 0, len = (bs->bits + 7) / 8;
+
+    if (bs->overflow || size < 5 + len + len / 2 + 1)
+        return 0;
+
+    out[n++] = 0x00;
+    out[n++] = 0x00;
+    out[n++] = 0x00;
+    out[n++] = 0x01;
+    out[n++] = nal_header;
+    for (i = 0; i < len; i++) {
+        if (zeros >= 2 && bs->buf[i] <= 0x03) {
+            out[n++] = 0x03;
+            zeros = 0;
+        }
+        out[n++] = bs->buf[i];
+        zeros = bs->buf[i] ? 0 : zeros + 1;
+    }
+    return n;
+}
+
+static unsigned h264_profile_idc(enum pipe_video_profile profile)
+{
+    switch (profile) {
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_BASELINE:
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_CONSTRAINED_BASELINE:
+        return 66;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_MAIN:
+        return 77;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_EXTENDED:
+        return 88;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH10:
+        return 110;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH422:
+        return 122;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH444:
+        return 244;
+    case PIPE_VIDEO_PROFILE_MPEG4_AVC_HIGH:
+    default:
+        return 100;
+    }
+}
