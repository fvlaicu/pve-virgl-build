+/*
+ * Local patch: the vl compositor (VA post-processing such as scale_vaapi;
+ * virgl has no video engine for it) reads a buffer's component views with
+ * TGSI_TEXTURE_2D_ARRAY shaders (create_frag_shader_yuv/weave), while
+ * progressive video buffers are plain 2D textures. Hardware drivers sample
+ * either way; on the virgl host the GLSL sampler2DArray finds no 2D_ARRAY
+ * texture bound and reads zeros, so scaled frames came out black. These are
+ * the views vl_video_buffer_sampler_view_components() makes, with target
+ * 2D_ARRAY (one layer), for which the host creates a GL texture view of that
+ * type (with VIRGL_CAP_TEXTURE_VIEW; without it nothing changes). Plane views
+ * stay 2D: vaPutSurface samples RGB planes with a 2D shader.
+ */
+static struct pipe_sampler_view **
+virgl_video_buffer_sampler_view_components(struct pipe_video_buffer *buffer)
+{
+    struct vl_video_buffer *buf = (struct vl_video_buffer *)buffer;
+    struct pipe_sampler_view sv_templ;
+    struct pipe_context *pipe = buf->base.context;
+    enum pipe_format sampler_format[VL_NUM_COMPONENTS];
+    const unsigned *plane_order;
+    unsigned i, j, component, num_planes;
+
+    vl_get_video_buffer_formats(pipe->screen, buf->base.buffer_format, sampler_format);
+    plane_order = vl_video_buffer_plane_order(buf->base.buffer_format);
+    num_planes = util_format_get_num_planes(buf->base.buffer_format);
+
+    for (component = 0, i = 0; i < num_planes; ++i) {
+        struct pipe_resource *res = buf->resources[plane_order[i]];
+        const struct util_format_description *desc = util_format_description(res->format);
+        unsigned nr_components = util_format_get_nr_components(res->format);
+        if (desc->layout == UTIL_FORMAT_LAYOUT_SUBSAMPLED)
+            nr_components = 3;
+
+        for (j = 0; j < nr_components && component < VL_NUM_COMPONENTS; ++j, ++component) {
+            unsigned pipe_swizzle;
+
+            if (buf->sampler_view_components[component])
+                continue;
+
+            memset(&sv_templ, 0, sizeof(sv_templ));
+            u_sampler_view_default_template(&sv_templ, res, sampler_format[plane_order[i]]);
+            if (sv_templ.target == PIPE_TEXTURE_2D && res->array_size == 1)
+                sv_templ.target = PIPE_TEXTURE_2D_ARRAY;
+            pipe_swizzle = (buf->base.buffer_format == PIPE_FORMAT_YUYV ||
+                            buf->base.buffer_format == PIPE_FORMAT_UYVY) ?
+                           (PIPE_SWIZZLE_X + j + 1) % 3 :
+                           (PIPE_SWIZZLE_X + j);
+            sv_templ.swizzle_r = sv_templ.swizzle_g = sv_templ.swizzle_b = pipe_swizzle;
+            sv_templ.swizzle_a = PIPE_SWIZZLE_1;
+
+            buf->sampler_view_components[component] = pipe->create_sampler_view(pipe, res, &sv_templ);
+            if (!buf->sampler_view_components[component])
+                goto error;
+        }
+    }
+
+    assert(component != 0);
+
+    for (i = component; i < VL_NUM_COMPONENTS; ++i)
+        buf->sampler_view_components[i] = buf->sampler_view_components[component - 1];
+
+    buf->num_sampler_view_components = component;
+
+    return buf->sampler_view_components;
+
+error:
+    for (i = 0; i < buf->num_sampler_view_components; ++i)
+        pipe->sampler_view_release(pipe, buf->sampler_view_components[i]);
+
+    return NULL;
+}
