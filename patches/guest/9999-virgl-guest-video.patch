+    if (codec->entrypoint == PIPE_VIDEO_ENTRYPOINT_BITSTREAM && vbuf) {
+        for (unsigned i = 0; i < vbuf->num_planes; i++) {
+            if (vbuf->plane_views[i])
+                virgl_resource_dirty(virgl_resource(vbuf->plane_views[i]->texture), 0);
+        }
+    }
