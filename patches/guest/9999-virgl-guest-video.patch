--- a/src/gallium/drivers/virgl/virgl_screen.c	2026-10-16 21:46:17.377882881 +0300
+++ b/src/gallium/drivers/virgl/virgl_screen.c	2026-10-16 21:46:29.516044304 +0300
@@ -771,6 +771,21 @@
                                             enum pipe_video_profile profile,
                                             enum pipe_video_entrypoint entrypoint)
 {
+    /*
+     * Local patch: decode targets and encoder input are VA surfaces on the
+     * host, which virglrenderer allocates from the chroma format alone
+     * (VA_RT_FORMAT_YUV420 -> NV12, VA_RT_FORMAT_YUV420_10 -> P010), and its
+     * copies pair guest and host planes by index. A guest buffer in another
+     * layout (I420, YV12, ...) loses planes: ffmpeg picks I420 for 8-bit
+     * decoding when it is offered, and V came out all zero. So offer only
+     * those two for decoding and encoding, as radeonsi does on bare metal.
+     */
+    if (profile != PIPE_VIDEO_PROFILE_UNKNOWN &&
+        (entrypoint == PIPE_VIDEO_ENTRYPOINT_BITSTREAM ||
+         entrypoint == PIPE_VIDEO_ENTRYPOINT_ENCODE) &&
+        format != PIPE_FORMAT_NV12 && format != PIPE_FORMAT_P010)
+        return false;
+
     return vl_video_buffer_is_format_supported(screen, format, profile, entrypoint);
 }
 
