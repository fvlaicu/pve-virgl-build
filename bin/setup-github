#!/usr/bin/env bash
# Sets the repo's GitHub settings and creates the empty state branch (README, "Setting up the repo"),
# through the GitHub CLI. Safe to run again: it sets the same values and only creates what's
# missing. Run it in your own terminal, logged in (gh auth login) as the repo's owner, once main has
# been pushed.
#   bin/setup-github [owner/repo]        default: build.conf's REPO
# Sets:
#   Actions        enabled; GitHub-owned actions only (ours are pinned by SHA); the token reads by default
#   Pages          built by Actions
#   publish        the environment holding the signing key: deploys from main only, no reviewers, no wait
#   state          the branch, if missing: one commit with its .gitignore, as DEBFULLNAME <DEBEMAIL>
# The key's secret is set afterwards; bin/make-key prints the command.
set -euo pipefail
export LC_ALL=C
infra=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# shellcheck source=../build.conf
. "$infra/build.conf"
(( $# <= 1 )) || { echo "usage: setup-github [owner/repo]"; exit 1; }
repo=${1:-$REPO}
[[ $repo =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || { echo "not owner/repo: $repo"; exit 1; }

vis=$(gh api "repos/$repo" --jq .visibility 2>/dev/null) ||
    { echo "$repo isn't on GitHub (or gh, logged in as $(gh api user --jq .login 2>/dev/null || echo nobody), can't see it): create it and push main first"; exit 1; }
[[ $vis == public ]] || { echo "$repo is $vis; it has to be public (free Actions minutes, Pages)"; exit 1; }
gh api "repos/$repo/branches/main" --silent 2>/dev/null || { echo "$repo has no main yet: push it first"; exit 1; }
# Schedules run on the default branch only.
[[ $(gh api "repos/$repo" --jq .default_branch) == main ]] || gh api -X PATCH "repos/$repo" -f default_branch=main --silent

echo "Actions: GitHub-owned actions only; the token reads by default"
gh api -X PUT "repos/$repo/actions/permissions" -F enabled=true -f allowed_actions=selected --silent
gh api -X PUT "repos/$repo/actions/permissions/selected-actions" --input - --silent <<'EOF'
{"github_owned_allowed": true, "verified_allowed": false, "patterns_allowed": []}
EOF
gh api -X PUT "repos/$repo/actions/permissions/workflow" -f default_workflow_permissions=read \
    -F can_approve_pull_request_reviews=false --silent

echo "Pages: built by Actions"
if gh api "repos/$repo/pages" --silent 2>/dev/null; then
    gh api -X PUT "repos/$repo/pages" -f build_type=workflow --silent
else
    gh api -X POST "repos/$repo/pages" -f build_type=workflow --silent
fi

echo "Environment publish: main only, no reviewers"
gh api -X PUT "repos/$repo/environments/publish" --input - --silent <<'EOF'
{"wait_timer": 0, "reviewers": [], "deployment_branch_policy": {"protected_branches": false, "custom_branch_policies": true}}
EOF
rules=$(gh api "repos/$repo/environments/publish/deployment-branch-policies" \
    --jq '.branch_policies[] | "\(.type // "branch") \(.name)"')
grep -qx 'branch main' <<<"$rules" ||
    gh api -X POST "repos/$repo/environments/publish/deployment-branch-policies" -f name=main -f type=branch --silent
other=$(grep -vx 'branch main' <<<"$rules" || true)
[[ -z $other ]] || { printf 'publish has other deployment rules; remove them in Settings → Environments → publish:\n%s\n' "$other"; exit 1; }

if gh api "repos/$repo/branches/state" --silent 2>/dev/null; then
    echo "Branch state: exists"
else
    echo "Branch state: creating"
    tmp=$(mktemp -d)
    trap 'rm -rf "$tmp"' EXIT
    git -C "$tmp" init -q -b state
    printf '%s\n' /upstream /run /apt/ > "$tmp/.gitignore"   # as lib/common.sh's state_gitignore writes it
    git -C "$tmp" add .gitignore
    git -C "$tmp" -c user.name="$DEBFULLNAME" -c user.email="$DEBEMAIL" -c commit.gpgsign=false \
        commit -qm "state: empty"
    if [[ $(gh config get git_protocol -h github.com 2>/dev/null) == ssh ]]; then url=git@github.com:$repo.git
    else url=https://github.com/$repo.git
    fi
    git -C "$tmp" push -q "$url" state
fi

echo
gh api "repos/$repo/actions/permissions" --jq '"actions:  enabled=\(.enabled) allowed=\(.allowed_actions)"'
gh api "repos/$repo/actions/permissions/selected-actions" \
    --jq '"          github_owned=\(.github_owned_allowed) verified=\(.verified_allowed) patterns=\(.patterns_allowed)"'
gh api "repos/$repo/actions/permissions/workflow" --jq '"          token=\(.default_workflow_permissions)"'
rc=0
html=$(gh api "repos/$repo/pages" --jq .html_url)
echo "pages:    $(gh api "repos/$repo/pages" --jq .build_type) $html"
[[ ${html%/} == "$PAGES_URL" ]] || { echo "          build.conf's PAGES_URL is $PAGES_URL: fix one of them"; rc=1; }
gh api "repos/$repo/environments/publish" \
    --jq '"publish:  branches=\(if .deployment_branch_policy.custom_branch_policies then "selected" else "any" end) protection=\([.protection_rules[]?.type])"'
echo "          rules: $(gh api "repos/$repo/environments/publish/deployment-branch-policies" --jq '[.branch_policies[].name] | join(" ")')"
echo
echo "Next: gh secret set VIRGL_SIGNING_KEY --env publish --repo $repo < <key dir>/secret.asc"
exit $rc
